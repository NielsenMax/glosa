      "language": "English",
      "definitions": [
        {
          "definition": "<span class=\"usage-label-sense\" about=\"#mwt688\" typeof=\"mw:Transclusion\"></span> An act or instance of spreading <span class=\"mention-gloss-paren\" about=\"#mwt689\" typeof=\"mw:Transclusion\">(</span><span class=\"mention-gloss\" about=\"#mwt689\">speedreading</span><span class=\"mention-gloss-paren\" about=\"#mwt689\">)</span>."
        }
      ]
    }
